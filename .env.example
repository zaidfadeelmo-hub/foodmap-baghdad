# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase:
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# رابط الموقع (يُستخدم في روابط تأكيد البريد وSEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# المدينة الافتراضية (slug). للتوسع لاحقاً: غيّرها أو أضف محدد مدن.
NEXT_PUBLIC_DEFAULT_CITY=baghdad

# ملاحظة: لا حاجة لمفتاح service_role. كل الصلاحيات تُدار عبر RLS.
# بدون القيمتين الأوليين يعمل الموقع في "وضع العرض التجريبي" ببيانات محلية.
